// Ráp Kèo — Prisma schema (theo docs/ERD.md)
// DB: PostgreSQL + PostGIS. Cột `location` dùng geography(Point, 4326).
// Prisma chưa hỗ trợ kiểu geography -> dùng Unsupported(); query "gần" bằng raw SQL (ST_DWithin/ST_Distance).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  // Connection URLs (DATABASE_URL runtime, DIRECT_URL migrate) cấu hình trong
  // prisma.config.ts (Prisma 7: datasource không còn hỗ trợ url/directUrl trực tiếp).
  // App dùng `postgis` (geography + ST_DWithin/ST_Distance).
  extensions = [postgis, postgis_topology, postgis_tiger_geocoder, fuzzystrmatch]
}

// ---------- Enums ----------

// Thang trình độ phủi, thứ tự từ yếu -> mạnh.
enum SkillTier {
  VERY_WEAK // Siêu Yếu
  WEAK // Yếu
  BELOW_AVERAGE // Trung Bình Yếu
  AVERAGE // Trung Bình
  ABOVE_AVERAGE // Trung Bình Khá
  GOOD // Khá
  STRONG // Mạnh
}

// skill_tier của Match: như SkillTier + ANY (lọc mọi trình độ)
enum MatchSkillTier {
  VERY_WEAK
  WEAK
  BELOW_AVERAGE
  AVERAGE
  ABOVE_AVERAGE
  GOOD
  STRONG
  ANY
}

enum FieldType {
  F5
  F7
  F11
}

enum TeamRole {
  OWNER
  MEMBER
}

enum MatchType {
  FIND_OPPONENT
  NEED_PLAYERS
  FIELD_AVAILABLE
  LOOKING_FOR_TEAM
  // Trận nội bộ team tự tạo (A vs B, không đối thủ ngoài, không lên /matches).
  INTERNAL
}

enum MatchStatus {
  OPEN
  MATCHED
  CONFIRMED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum MatchRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum InternalSquadSide {
  SIDE_A
  SIDE_B
  BENCH
}

enum NotificationType {
  MATCH_REQUEST
  REQUEST_ACCEPTED
  REQUEST_REJECTED
  MATCH_CONFIRMED
}

// Vai trò user. ADMIN: có quyền tạo kèo từ text (AI parse) + các thao tác admin khác.
enum UserRole {
  USER
  ADMIN
}

// Thể thức giải đấu. MVP: chỉ LEAGUE (đãi vòng tròn 1 lượt).
// Mở rộng sau: KNOCKOUT_4, KNOCKOUT_8, GROUPS_PLUS_KNOCKOUT.
enum TournamentFormat {
  LEAGUE
}

// Trạng thái giải. DRAFT -> PENDING (gửi duyệt) -> APPROVED/REJECTED.
// APPROVED -> COMPLETED (tất cả trận xong) hoặc CANCELLED.
enum TournamentStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

// Trạng thái participant. MVP: organizer thêm trực tiếp -> mặc định ACCEPTED.
// PENDING/REJECTED dành cho self-registration (task sau).
enum TournamentParticipantStatus {
  ACCEPTED
  PENDING
  REJECTED
}

// ---------- Models ----------

model User {
  id        String   @id @default(uuid()) @db.Uuid
  // Đăng nhập đa phương thức: user có thể có phone, email hoặc cả hai.
  phone     String?  @unique
  email     String?  @unique
  // Hash (bcrypt) cho user đăng nhập thủ công bằng SĐT + mật khẩu.
  // Nullable: user đăng nhập bằng Google không có mật khẩu.
  passwordHash String? @map("password_hash")
  // name nullable: cho user nhập sau khi đăng nhập lần đầu (onboarding).
  name      String?
  hometown  String?
  avatarUrl String?  @map("avatar_url")
  // Vai trò: USER mặc định; ADMIN có quyền parse text tạo kèo + quản trị.
  role      UserRole @default(USER) @map("role")
  // Guest = thành viên thêm bằng tên (không có tài khoản / không đăng nhập được).
  // name-only, phone/email/passwordHash null. Sau này đăng ký SĐT -> upgrade thành
  // user thật, giữ nguyên membership + stats.
  isGuest   Boolean  @default(false) @map("is_guest")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // NextAuth OAuth: mỗi user có thể có nhiều Account (Google, ...).
  accounts        Account[]

  ownedTeams      Team[]         @relation("TeamOwner")
  teamMemberships TeamMember[]
  ownedFields     Field[]
  createdMatches  Match[]
  matchRequests   MatchRequest[]
  notifications   Notification[]
  webPushSubscriptions WebPushSubscription[]
  // Vua phá lưới / kiến tạo: mỗi user có nhiều dòng PlayerStat (1 trận / 1 đội).
  playerStats     PlayerStat[]
  // MVP vote theo trận: session user tạo + vote user gửi/được nhận.
  createdMvpVoteSessions MatchMvpVoteSession[] @relation("MvpVoteSessionCreator")
  wonMvpVoteSessions     MatchMvpVoteSession[] @relation("MvpVoteSessionWinner")
  castMvpVotes           MatchMvpVote[]        @relation("MvpVoteVoter")
  castMvpDeviceVotes     MatchMvpDeviceVote[]  @relation("MvpDeviceVoteVoter")
  receivedMvpVotes       MatchMvpVote[]        @relation("MvpVoteCandidate")
  matchSquadMembers      MatchSquadMember[]
  // Giải đấu user làm organizer (tạo giải).
  organizedTournaments Tournament[] @relation("TournamentOrganizer")
  // Cầu thủ của participant giải gắn với user (chọn từ TeamMember hoặc tự thêm).
  tournamentPlayers     TournamentPlayer[]

  @@map("users")
}

// Lưu token OAuth (Google) — schema chuẩn của NextAuth adapter.
// Cho phép link account OAuth vào user đã có (cùng email) và đăng nhập lại sau.
model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refreshToken      String? @map("refresh_token")
  accessToken       String? @map("access_token")
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @map("id_token")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Team {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  ownerId   String    @map("owner_id") @db.Uuid
  skillTier SkillTier @map("skill_tier")
  homeArea  String?   @map("home_area")
  // geography(Point, 4326) — gán/đọc qua raw SQL
  location  Unsupported("geography(Point, 4326)")?
  logoUrl   String?   @map("logo_url")
  // Ảnh bìa đội (URL public từ Supabase Storage bucket team-assets). Nullable: mặc định.
  coverUrl  String?   @map("cover_url")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  owner            User           @relation("TeamOwner", fields: [ownerId], references: [id])
  members          TeamMember[]
  matches          Match[]
  requestsFromTeam MatchRequest[]
  // Bảng PlayerStat của đội (per-match, per-player) -> aggregate leaderboard.
  playerStats      PlayerStat[]
  // Giải đấu đội tham gia (qua TournamentParticipant). teamId nullable trên
  // participant (team lẻ không gắn Team) -> không dùng every/some trực tiếp.
  tournamentParticipants TournamentParticipant[]

  @@index([ownerId])
  @@map("teams")
}

model TeamMember {
  id           String   @id @default(uuid()) @db.Uuid
  teamId       String   @map("team_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  role         TeamRole @default(MEMBER)
  jerseyNumber Int?     @map("jersey_number")
  joinedAt     DateTime @default(now()) @map("joined_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model Field {
  id         String                                @id @default(uuid()) @db.Uuid
  name       String
  address    String
  location   Unsupported("geography(Point, 4326)")
  fieldTypes FieldType[]                           @map("field_types")
  ownerId    String?                               @map("owner_id") @db.Uuid
  phone      String?
  createdAt  DateTime                              @default(now()) @map("created_at")
  updatedAt  DateTime                              @updatedAt @map("updated_at")

  owner   User?   @relation(fields: [ownerId], references: [id])
  matches Match[]

  @@map("fields")
}

model Match {
  id          String                                 @id @default(uuid()) @db.Uuid
  creatorId   String                                 @map("creator_id") @db.Uuid
  teamId      String?                                @map("team_id") @db.Uuid
  matchType   MatchType                              @map("match_type")
  fieldType   FieldType                              @map("field_type")
  // Mảng trình độ: kèo có thể mở cho nhiều trình độ cùng lúc (vd Khá + Mạnh).
  skillTiers  MatchSkillTier[]                       @map("skill_tiers")
  fieldId     String?                                @map("field_id") @db.Uuid
  area        String?
  location    Unsupported("geography(Point, 4326)")?
  // Mảng giờ đá: 1 kèo có thể mở nhiều giờ trong ngày (vd 18h30 + 20h30).
  playTimes   DateTime[]                             @map("play_times")
  note        String?
  status      MatchStatus                            @default(OPEN)
  // Tỷ số trận (ghi khi trận COMPLETED). home = đội tạo/đại diện kèo (teamId),
  // away = đội khách (resolve từ request ACCEPTED). Nullable: chưa đá / chưa chốt.
  homeScore   Int?                                   @map("home_score")
  awayScore   Int?                                   @map("away_score")
  // Trận team tự tạo (matchType FIND_OPPONENT từ team detail): tên đối thủ nhập tay
  // (chưa có team thật). Nullable: chỉ dùng cho trận do team tạo có đối thủ tự do.
  opponentName String?                               @map("opponent_name")
  // Trận nội bộ (matchType INTERNAL): tên 2 bên tự chia (vd "Đội xanh" vs "Đội đỏ").
  // home = sideA, away = sideB. Nullable: chỉ dùng cho INTERNAL.
  sideAName   String?                               @map("side_a_name")
  sideBName   String?                               @map("side_b_name")
  // true = trận do team tự tạo, KHÔNG hiện trên bảng kèo công khai /matches.
  // false (mặc định) = kèo public (flow tạo kèo cũ).
  isPrivate   Boolean  @default(false)              @map("is_private")
  // Đánh dấu đã seed đội hình mặc định từ TeamMember cho trận kèo.
  // INTERNAL để null (flow chốt sau), tránh tự seed lại sau khi đội trưởng remove hết.
  squadSeededAt DateTime?                           @map("squad_seeded_at")
  createdAt   DateTime                               @default(now()) @map("created_at")
  updatedAt   DateTime                               @updatedAt @map("updated_at")

  creator  User           @relation(fields: [creatorId], references: [id])
  team     Team?          @relation(fields: [teamId], references: [id])
  field    Field?         @relation(fields: [fieldId], references: [id])
  requests MatchRequest[]
  // Bàn thắng / kiến tạo của từng cầu thủ trong trận (ghi khi COMPLETED).
  playerStats PlayerStat[]
  // Phiên vote MVP của trận (1 trận tối đa 1 phiên vote).
  mvpVoteSession MatchMvpVoteSession?
  // Đội hình ra sân của trận (snapshot theo trận, owner có thể remove người không đá).
  squadMembers MatchSquadMember[]
  // Trận thuộc giải đấu (nullable: trận thường / team match không thuộc giải).
  tournamentId String?                              @map("tournament_id") @db.Uuid
  tournament   Tournament?                          @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  // Vòng đấu (chỉ tournament match LEAGUE): 1..N-1 (N chẵn) hoặc 1..N (N lẻ có bye).
  // Nullable: trận thường / team match không thuộc giải. Set lúc sinh fixture.
  round        Int?

  @@index([creatorId])
  @@index([teamId])
  @@index([fieldId])
  @@index([tournamentId])
  // lọc kèo OPEN có giờ sắp tới: query lọc trong app (array không dùng B-tree trực tiếp).
  @@map("matches")
}

// Đội hình ra sân theo trận: snapshot thành viên đội ở thời điểm seed trận kèo.
// INTERNAL chưa dùng (flow chốt sau). Unique (matchId, userId) để tránh trùng người.
model MatchSquadMember {
  id        String   @id @default(uuid()) @db.Uuid
  matchId   String   @map("match_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  internalSide InternalSquadSide? @map("internal_side")
  createdAt DateTime @default(now()) @map("created_at")

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@index([userId])
  @@index([matchId, internalSide])
  @@map("match_squad_members")
}

model MatchRequest {
  id              String             @id @default(uuid()) @db.Uuid
  matchId         String             @map("match_id") @db.Uuid
  requesterId     String             @map("requester_id") @db.Uuid
  requesterTeamId String?            @map("requester_team_id") @db.Uuid
  status          MatchRequestStatus @default(PENDING)
  message         String?
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  match         Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  requester     User  @relation(fields: [requesterId], references: [id])
  requesterTeam Team? @relation(fields: [requesterTeamId], references: [id])

  @@index([matchId])
  @@index([requesterId])
  @@map("match_requests")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  payload   Json
  read      Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

// Web Push subscriptions theo từng thiết bị/browser của user.
// endpoint unique toàn cục; 1 user có thể có nhiều subscription (điện thoại, laptop).
model WebPushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("web_push_subscriptions")
}

// Số liệu cầu thủ trong 1 trận: bàn thắng / kiến tạo. Per-match, per-player.
// 2 chế độ player:
// - User hệ thống: userId != null, participantPlayerId null. (Match thường + tournament
//   match khi chọn từ TeamMember có user thật.)
// - Cầu thủ ngoài giải: userId null, participantPlayerId != null. (Tournament match khi
//   chọn TournamentPlayer.userId null — chỉ có tên.)
// displayName: snapshot tên lúc ghi — dùng cho leaderboard không cần hydrate lại.
// teamId nullable: tournament match của team lẻ (participant.teamId null) không có team
// thật. participantId: chỉ tournament stat (nullable cho match thường).
// Cascade theo match (xóa trận -> xóa stat); user/team/participant/player xóa -> cascade.
model PlayerStat {
  id           String  @id @default(uuid()) @db.Uuid
  matchId      String  @map("match_id") @db.Uuid
  teamId       String? @map("team_id") @db.Uuid
  userId       String? @map("user_id") @db.Uuid
  // Link tới TournamentPlayer (cầu thủ ngoài giải, userId null). Nullable: stat cho
  // user hệ thống thì null. XOR với userId (refine ở action, không enforce DB).
  participantPlayerId String? @map("participant_player_id") @db.Uuid
  // Participant mà player thuộc (chỉ tournament stat). Nullable cho match thường.
  // Dùng cho leaderboard hydrate participantDisplayName + filter theo giải.
  participantId       String? @map("participant_id") @db.Uuid
  displayName  String  @map("display_name")
  goals        Int     @default(0)
  assists      Int     @default(0)
  saves        Int     @default(0)

  match             Match             @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team              Team?             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user              User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  participantPlayer TournamentPlayer? @relation(fields: [participantPlayerId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([userId])
  @@index([participantPlayerId])
  @@index([participantId])
  @@map("player_stats")
}

// Phiên vote MVP theo trận. Link share dùng token plaintext (chỉ trả 1 lần cho UI),
// DB chỉ lưu token_hash để tránh lộ link nếu leak DB.
// Mỗi trận tối đa 1 session MVP (matchId unique).
model MatchMvpVoteSession {
  id              String    @id @default(uuid()) @db.Uuid
  matchId         String    @unique @map("match_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash")
  expiresAt       DateTime  @map("expires_at")
  closedAt        DateTime? @map("closed_at")
  createdByUserId String    @map("created_by_user_id") @db.Uuid
  winnerUserId    String?   @map("winner_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  match         Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  createdByUser User   @relation("MvpVoteSessionCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  winnerUser    User?  @relation("MvpVoteSessionWinner", fields: [winnerUserId], references: [id], onDelete: SetNull)
  votes         MatchMvpVote[]
  deviceVotes   MatchMvpDeviceVote[]

  @@index([expiresAt])
  @@index([closedAt])
  @@index([winnerUserId])
  @@map("match_mvp_vote_sessions")
}

// Phiếu vote MVP: 1 voter chỉ có 1 phiếu trong 1 session.
model MatchMvpVote {
  id              String   @id @default(uuid()) @db.Uuid
  sessionId       String   @map("session_id") @db.Uuid
  voterUserId     String   @map("voter_user_id") @db.Uuid
  candidateUserId String   @map("candidate_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  session       MatchMvpVoteSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  voterUser     User                @relation("MvpVoteVoter", fields: [voterUserId], references: [id], onDelete: Cascade)
  candidateUser User                @relation("MvpVoteCandidate", fields: [candidateUserId], references: [id], onDelete: Cascade)

  @@unique([sessionId, voterUserId])
  @@index([sessionId, candidateUserId])
  @@index([candidateUserId])
  @@map("match_mvp_votes")
}

// Khóa vote theo thiết bị cho mỗi session MVP.
// Mỗi thiết bị (hash từ cookie định danh thiết bị) chỉ được ghi 1 phiếu/session.
model MatchMvpDeviceVote {
  id         String   @id @default(uuid()) @db.Uuid
  sessionId  String   @map("session_id") @db.Uuid
  deviceHash String   @map("device_hash")
  voterUserId String  @map("voter_user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  session   MatchMvpVoteSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  voterUser User                @relation("MvpDeviceVoteVoter", fields: [voterUserId], references: [id], onDelete: Cascade)

  @@unique([sessionId, deviceHash])
  @@index([sessionId])
  @@index([voterUserId])
  @@map("match_mvp_device_votes")
}

// Giải đấu. Organizer (User) tạo -> ADMIN duyệt -> public trên /tournaments.
// Trận của giải lưu trong bảng Match (tournamentId != null, matchType INTERNAL,
// isPrivate true). MVP: format LEAGUE (đãi vòng tròn 1 lượt).
model Tournament {
  id           String           @id @default(uuid()) @db.Uuid
  name         String
  // Slug cho URL /tournaments/[slug]. Sinh từ name (slugify bỏ dấu tiếng Việt),
  // auto suffix -2, -3... khi trùng. Unique trong toàn bộ table.
  slug         String           @unique
  description  String?
  bannerUrl    String?          @map("banner_url")
  fieldType    FieldType        @map("field_type")
  format       TournamentFormat
  // Trình độ mong muốn (tùy chọn, chỉ hiển thị — không enforce khi add participant).
  skillTier    SkillTier?       @map("skill_tier")
  area         String?
  organizerId  String           @map("organizer_id") @db.Uuid
  status       TournamentStatus @default(DRAFT)
  // startedAt: khi organizer "Bắt đầu giải" -> sinh fixture + lock participants.
  startedAt    DateTime?        @map("started_at")
  completedAt  DateTime?        @map("completed_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt        @map("updated_at")

  organizer    User                     @relation("TournamentOrganizer", fields: [organizerId], references: [id])
  participants TournamentParticipant[]
  matches      Match[]

  @@index([organizerId])
  @@index([status])
  @@map("tournaments")
}

// Đội tham gia giải. teamId null = team lẻ (chỉ displayName). teamId != null =
// team thật trong hệ thống. displayName là identifier trong giải (copy từ
// Team.name hoặc nhập tay) — unique trong 1 giải.
model TournamentParticipant {
  id           String                      @id @default(uuid()) @db.Uuid
  tournamentId String                      @map("tournament_id") @db.Uuid
  teamId       String?                     @map("team_id") @db.Uuid
  displayName  String                      @map("display_name")
  status       TournamentParticipantStatus @default(ACCEPTED)
  joinedAt     DateTime                    @default(now()) @map("joined_at")

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team       Team?      @relation(fields: [teamId], references: [id], onDelete: SetNull)
  players    TournamentPlayer[]

  @@unique([tournamentId, displayName])
  @@index([tournamentId])
  @@index([teamId])
  @@map("tournament_participants")
}

// Cầu thủ của 1 participant trong giải. Per-participant (tách biệt TeamMember):
// prefill từ TeamMember khi participant là team hệ thống, nhưng thêm/bớt trong
// giải không động đến TeamMember gốc. userId null = cầu thủ ngoài (chỉ tên).
// Cascade theo participant (xóa đội khỏi giải -> xóa hết cầu thủ).
model TournamentPlayer {
  id            String   @id @default(uuid()) @db.Uuid
  participantId String   @map("participant_id") @db.Uuid
  // Nullable: null = cầu thủ ngoài (chỉ displayName). != null = link tới User
  // (khi chọn từ TeamMember, có thể là user thật hoặc guest).
  userId        String?  @map("user_id") @db.Uuid
  displayName   String   @map("display_name")
  // Số áo (tùy chọn). Unique trong 1 participant để tránh trùng số.
  jerseyNumber  Int?     @map("jersey_number")
  createdAt     DateTime @default(now()) @map("created_at")

  participant TournamentParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  user        User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Back-ref PlayerStat khi player này ghi bàn trong trận của giải.
  playerStats PlayerStat[]

  @@unique([participantId, userId])
  @@unique([participantId, jerseyNumber])
  @@index([participantId])
  @@map("tournament_players")
}

// OTP đặt lại mật khẩu: sinh khi user quên mk, gửi tới admin (qua email) để forward
// cho user. Hash bằng bcrypt (không lưu plaintext — nếu DB leak không lộ OTP).
// expiresAt: hết hạn sau 15 phút. usedAt: mark sau khi verify thành công (ngăn replay).
// Cleanup: không cần cron — query filter expiresAt > now; row cũ tự bỏ qua (MVP).
model PasswordResetOtp {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String
  // Hash OTP bằng bcrypt (10 rounds). Không lưu plaintext.
  otpHash    String    @map("otp_hash")
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([phone, expiresAt])
  @@map("password_reset_otps")
}
